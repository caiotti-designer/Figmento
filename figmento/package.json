{
  "name": "figmento",
  "version": "1.0.0",
  "description": "Unified Figma AI design plugin — 5 design modes, chat agent with iterative tool loop, and MCP WebSocket bridge",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "npx tsx ../scripts/generate-tool-schemas.ts && npx tsx scripts/compile-knowledge.ts",
    "pretest": "npx tsx ../scripts/generate-tool-schemas.ts",
    "build": "plugma build --mode production",
    "build:prod": "plugma build --mode production",
    "watch": "plugma dev",
    "dev": "plugma dev",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check"
  },
  "plugma": {
    "manifest": {
      "name": "Figmento",
      "id": "figmento-plugin",
      "api": "1.0.0",
      "main": "src/code.ts",
      "ui": "src/ui/index.ts",
      "editorType": [
        "figma"
      ],
      "networkAccess": {
        "allowedDomains": [
          "https://api.anthropic.com",
          "https://api.openai.com",
          "https://generativelanguage.googleapis.com",
          "https://unpkg.com",
          "https://fonts.googleapis.com",
          "https://fonts.gstatic.com",
          "https://figmento-production.up.railway.app",
          "wss://figmento-production.up.railway.app",
          "https://figmento-ws-relay.fly.dev",
          "wss://figmento-ws-relay.fly.dev",
          "https://api.venice.ai",
          "https://chatgpt.com",
          "https://auth.openai.com"
        ],
        "devAllowedDomains": [
          "http://localhost:3055",
          "ws://localhost:3055"
        ],
        "reasoning": "Anthropic/OpenAI/Gemini APIs for AI chat + design, Google Fonts for text rendering, unpkg for external assets, Fly.io cloud relay for chat + bridge, Railway legacy relay, localhost for local dev relay"
      },
      "permissions": [
        "currentuser"
      ]
    }
  },
  "keywords": [
    "figma",
    "plugin",
    "screenshot",
    "ai",
    "design"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.3.0",
    "@figma/plugin-typings": "^1.98.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "js-yaml": "^4.1.1",
    "plugma": "^2.2.3",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "zod-to-json-schema": "^3.24.0"
  },
  "dependencies": {
    "nanostores": "^1.3.0"
  }
}
